{
  "name": "espia",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "types": "wrangler types",
    "dev:worker": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "smoke": "node scripts/smoke-signaling.mjs",
    "dev:lan": "vite build && wrangler dev --ip 0.0.0.0 --port 8787 --local-protocol https",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "memoria": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/memoria.ps1",
    "desktop:release": "tauri build && node scripts/copy-installer.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.10",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.155.0"
  },
  "dependencies": {
    "@fontsource/caprasimo": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@lucide/svelte": "^1.63.0",
    "@tauri-apps/api": "^2.12.4"
  }
}
