{
  // Espia: o Worker entrega o site (dist/) e a API; cada sala é um Durable Object.
  // Ver specs/001-espia-screen-share/architecture.md e contracts/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "espia",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // Tolerância de reconexão e reserva do código (ms). Os testes encurtam.
  // TURN_KEY_ID não é segredo. O TURN_KEY_API_TOKEN é: fica em .dev.vars (local) e
  // `wrangler secret put TURN_KEY_API_TOKEN` (produção). Sem ele, só STUN.
  "vars": { "GRACE_MS": "20000", "RESERVE_MS": "60000", "TURN_KEY_ID": "5763b3ccb03eddac764bd1f400e9df54" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Limites por IP (contracts/http-api.md). O período só pode ser 10 ou 60 s.
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_LOOKUP", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_WS", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ]
}
