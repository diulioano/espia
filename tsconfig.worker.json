{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["worker-configuration.d.ts", "src/worker/**/*.ts", "src/shared/**/*.ts", "src/lib/room-id.ts", "test/worker/**/*.ts"]
}
