// Seletor da entrada de som da câmera (o `<select>` de GoLiveModal.svelte, aba Câmeras): pílula de 40px com a entrada
// escolhida e a seta; abre a lista com "Sem som" e as entradas. Devolve o id escolhido ("" = sem som).

import { Tokens } from "../tokens.slint";
import { Icon, Icons } from "icon.slint";
import { AudioOption } from "room-state.slint";

export component AudioSelect inherits Rectangle {
    in property <[AudioOption]> options;
    // Id da entrada escolhida ("" = sem som) e o nome dela.
    in property <string> current: "";
    in property <string> current-label: "";
    callback picked(string);

    min-height: 40px;
    max-height: 40px;
    preferred-height: 40px;
    border-radius: self.height / 2;
    background: Tokens.color-text.with-alpha(0.07);
    border-width: 1px;
    border-color: ta.has-hover ? Tokens.color-text.with-alpha(0.45) : Tokens.color-divider;
    accessible-role: combobox;
    accessible-label: "Entrada de som";
    accessible-value: root.current-label == "" ? "Sem som" : root.current-label;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: root.current-label == "" ? "Sem som" : root.current-label;
            font-family: Tokens.font-body;
            font-size: 14px;
            color: Tokens.color-text;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                source: Icons.chevron-down;
                size: 16px;
                tint: Tokens.color-text.with-alpha(0.7);
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: list.preferred-height;
        Rectangle {
            border-radius: 22px;
            background: Tokens.color-raised;
            border-width: Tokens.shadow-lg-ring-width;
            border-color: Tokens.shadow-lg-ring;
        }
        list := VerticalLayout {
            padding: 8px;
            spacing: 2px;
            Rectangle {
                min-height: 40px;
                border-radius: self.height / 2;
                background: none-ta.has-hover || root.current == "" ? Tokens.color-text.with-alpha(0.08) : transparent;
                Text {
                    x: 14px;
                    text: "Sem som";
                    font-family: Tokens.font-body;
                    font-size: 14px;
                    color: Tokens.color-text;
                    vertical-alignment: center;
                }
                none-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.picked("");
                        popup.close();
                    }
                }
            }
            for o in root.options: Rectangle {
                min-height: 40px;
                border-radius: self.height / 2;
                background: opt-ta.has-hover || root.current == o.id ? Tokens.color-text.with-alpha(0.08) : transparent;
                Text {
                    x: 14px;
                    width: parent.width - 28px;
                    text: o.label;
                    font-family: Tokens.font-body;
                    font-size: 14px;
                    color: Tokens.color-text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                opt-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.picked(o.id);
                        popup.close();
                    }
                }
            }
        }
    }
}
