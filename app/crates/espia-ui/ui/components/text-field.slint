// Campo de texto. Porte de src/ui/components/TextField.svelte + `.input` de src/ui/base.css:
// rótulo em cima (14px/600), pílula de 50px, ajuda ou erro embaixo.
// Limite de tamanho (ex.: apelido até 24) a Slint não tem: a tela corta o texto em `edited`.

import { Tokens } from "../tokens.slint";

export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> label;
    in property <string> hint;
    // Texto de erro; vazio = sem erro.
    in property <string> error;
    in property <string> placeholder;
    in property <bool> enabled: true;
    out property <bool> has-focus: ti.has-focus;
    callback accepted(string);
    callback edited(string);

    public function focus-input() { ti.focus(); }
    public function select-all() { ti.select-all(); }

    preferred-height: col.preferred-height;
    preferred-width: 320px;
    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.text;

    col := VerticalLayout {
        spacing: 8px;
        if root.label != "": Text {
            text: root.label;
            font-family: Tokens.font-body;
            font-size: 14px;
            font-weight: 600;
            color: Tokens.color-text;
            opacity: 0.8;
        }
        field := Rectangle {
            min-height: 50px;
            max-height: 50px;
            border-radius: self.height / 2;
            background: Tokens.color-surface;
            border-width: 1px;
            border-color: ti.has-focus ? Tokens.color-accent
                : root.error != "" ? Tokens.color-accent-400
                : hover.has-hover ? Tokens.color-text.with-alpha(0.45)
                : Tokens.color-divider;
            opacity: root.enabled ? 1 : 0.6;

            // --ring-focus: anel de 3px por fora quando o campo tem foco.
            if ti.has-focus: Rectangle {
                x: -Tokens.ring-focus-width;
                y: -Tokens.ring-focus-width;
                width: field.width + 2 * Tokens.ring-focus-width;
                height: field.height + 2 * Tokens.ring-focus-width;
                border-radius: self.height / 2;
                border-width: Tokens.ring-focus-width;
                border-color: Tokens.ring-focus-color;
            }

            // Fica por baixo do TextInput: o hover só vale nas bordas, onde o TextInput não pega o mouse.
            hover := TouchArea { }
            clip-box := Rectangle {
                x: 20px;
                width: parent.width - 40px;
                clip: true;
                if root.text == "" && root.placeholder != "": Text {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    text: root.placeholder;
                    font-family: Tokens.font-body;
                    font-size: 16px;
                    color: Tokens.color-text-muted;
                    overflow: elide;
                }
                ti := TextInput {
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    vertical-alignment: center;
                    text <=> root.text;
                    enabled: root.enabled;
                    single-line: true;
                    font-family: Tokens.font-body;
                    font-size: 16px;
                    color: Tokens.color-text;
                    selection-background-color: Tokens.color-accent.with-alpha(0.45);
                    selection-foreground-color: Tokens.color-text;
                    accepted => { root.accepted(self.text); }
                    edited => { root.edited(self.text); }
                }
            }
        }
        if root.error != "": Text {
            text: root.error;
            font-family: Tokens.font-body;
            font-size: 12px;
            color: Tokens.color-accent-300;
            wrap: word-wrap;
        }
        if root.error == "" && root.hint != "": Text {
            text: root.hint;
            font-family: Tokens.font-body;
            font-size: 13px;
            color: Tokens.color-text.with-alpha(0.55);
            wrap: word-wrap;
        }
    }
}
