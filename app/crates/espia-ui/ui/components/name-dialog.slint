// Nome da sala fixa (porte de src/ui/components/NameDialog.svelte): criar (F7) ou renomear (S3).
// Selo de alfinete (só ao criar), título, campo com contador e as duas ações. O limite de 40 caracteres e a
// regra do nome válido ficam no Rust (callbacks puros); a tela só desenha e devolve o nome em `submit`.

import { Tokens } from "../tokens.slint";
import { Icon, Icons } from "icon.slint";
import { Button, ButtonKind, IconButton } from "buttons.slint";
import { InputPill } from "input-pill.slint";
import { ModalFrame } from "modal-frame.slint";

export component NameDialog inherits ModalFrame {
    // true = "Criar sala fixa"; false = "Renomear sala".
    in property <bool> create: true;
    in property <bool> busy: false;
    in property <string> error;
    // Texto inicial do campo (o site o copia uma vez ao abrir).
    in property <string> initial;
    in-out property <string> text: root.initial;
    // Até 40 caracteres (emoji conta 1): o Rust corta ao digitar e diz se o nome vale.
    pure callback limit(string) -> string;
    pure callback normalize(string) -> string;
    callback submit(string);

    property <bool> can-submit: root.normalize(root.text) != "" && !root.busy;

    function try-submit() {
        if (root.can-submit) {
            root.submit(root.normalize(root.text));
        }
    }

    VerticalLayout {
        spacing: 22px;
        // .head: selo, títulos e botão de fechar.
        HorizontalLayout {
            spacing: 14px;
            if root.create: VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: Tokens.color-accent-2-300;
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: Icons.pin;
                        size: 22px;
                        tint: Tokens.color-accent-2-900;
                    }
                }
            }
            VerticalLayout {
                spacing: 2px;
                alignment: start;
                Text {
                    text: root.create ? "Criar sala fixa" : "Renomear sala";
                    font-family: Tokens.font-heading;
                    font-size: 26px;
                    color: Tokens.color-text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.create
                        ? "O link não muda. Fixe no grupo e use sempre o mesmo. Some se ficar 30 dias sem uso."
                        : "O link continua o mesmo.";
                    font-family: Tokens.font-body;
                    font-size: 14px;
                    color: Tokens.color-text.with-alpha(0.62);
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: start;
                IconButton {
                    icon: Icons.x;
                    label: "Fechar";
                    clicked => { root.close(); }
                }
            }
        }

        // .field: rótulo, campo de 54px e a linha de ajuda com o contador.
        VerticalLayout {
            spacing: 8px;
            Text {
                text: "Nome da sala";
                font-family: Tokens.font-body;
                font-size: 13px;
                font-weight: 600;
                color: Tokens.color-text.with-alpha(0.75);
            }
            field := InputPill {
                field-height: 54px;
                font-size: 17px;
                pad-h: 20px;
                fill: Tokens.color-bg;
                invalid: root.error != "";
                enabled: !root.busy;
                text <=> root.text;
                edited(t) => { root.text = root.limit(t); }
                accepted => { root.try-submit(); }
            }
            HorizontalLayout {
                spacing: 12px;
                Text {
                    horizontal-stretch: 1;
                    text: root.error != "" ? root.error
                        : root.create ? "Aparece só na tela, nunca no link." : "";
                    font-family: Tokens.font-body;
                    font-size: 12px;
                    color: root.error != "" ? Tokens.color-accent-300 : Tokens.color-text.with-alpha(0.5);
                    wrap: word-wrap;
                }
                Text {
                    text: root.text.character-count + "/40";
                    font-family: Tokens.font-body;
                    font-size: 12px;
                    color: Tokens.color-text.with-alpha(0.5);
                    horizontal-alignment: right;
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            alignment: end;
            Button {
                kind: ButtonKind.secondary;
                label: "Cancelar";
                clicked => { root.close(); }
            }
            Button {
                kind: ButtonKind.primary;
                label: root.create ? "Criar e entrar" : "Salvar";
                pad-h: 22px;
                enabled: root.can-submit;
                clicked => { root.try-submit(); }
            }
        }
    }

    init => {
        field.focus-input();
        field.select-all();
    }
}
