// Menu "⋯" de uma linha de Suas salas (variante `saved` de src/ui/components/RoomMenu.svelte): Renomear e Apagar
// só para o dono, e "Tirar da lista" com a nota. Largura 220, raio 22, fundo `raised` com anel e sombra.

import { Tokens } from "../tokens.slint";
import { Icon, Icons } from "icon.slint";

component Item inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> danger: false;
    callback clicked();

    property <color> fg: root.danger ? Tokens.color-accent-300 : Tokens.color-text;

    min-height: 44px;
    max-height: 44px;
    border-radius: self.height / 2;
    background: ta.has-hover ? (root.danger ? Tokens.color-accent.with-alpha(0.14) : Tokens.color-text.with-alpha(0.08)) : transparent;
    accessible-role: button;
    accessible-label: root.label;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                size: 16px;
                tint: root.fg;
            }
        }
        Text {
            text: root.label;
            font-family: Tokens.font-body;
            font-size: 14px;
            font-weight: 600;
            color: root.fg;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SavedMenu inherits Rectangle {
    // Só o dono renomeia e apaga.
    in property <bool> own: false;
    callback rename();
    callback remove();
    callback forget();

    width: 220px;
    height: col.preferred-height;
    border-radius: 22px;
    background: Tokens.color-raised;
    border-width: Tokens.shadow-lg-ring-width;
    border-color: Tokens.shadow-lg-ring;
    drop-shadow-color: Tokens.shadow-lg-color;
    drop-shadow-offset-y: Tokens.shadow-lg-offset-y;
    drop-shadow-blur: Tokens.shadow-lg-blur;
    accessible-role: none;

    // Come o clique para não fechar o menu por baixo.
    TouchArea { }

    col := VerticalLayout {
        padding: 8px;
        spacing: 2px;
        if root.own: Item {
            label: "Renomear sala";
            icon: Icons.pencil;
            clicked => { root.rename(); }
        }
        if root.own: Item {
            label: "Apagar sala";
            icon: Icons.trash;
            danger: true;
            clicked => { root.remove(); }
        }
        if root.own: Rectangle {
            height: 9px;
            Rectangle {
                x: 10px;
                y: 4px;
                width: parent.width - 20px;
                height: 1px;
                background: Tokens.color-text.with-alpha(0.1);
            }
        }
        Item {
            label: "Tirar da lista";
            icon: Icons.list-minus;
            clicked => { root.forget(); }
        }
        Text {
            text: "Some só deste aparelho. A sala continua pros outros.";
            font-family: Tokens.font-body;
            font-size: 12px;
            color: Tokens.color-text.with-alpha(0.55);
            wrap: word-wrap;
        }
    }
}
