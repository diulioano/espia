; Frases do instalador em português informal (specs/008 research R3). Mesmas chaves do arquivo oficial do
; Tauri 2.12.4 (crates/tauri-bundler/src/bundle/windows/nsis/languages/PortugueseBR.nsh).
LangString addOrReinstall ${LANG_PORTUGUESEBR} "Adicionar ou reinstalar"
LangString alreadyInstalled ${LANG_PORTUGUESEBR} "Já instalado"
LangString alreadyInstalledLong ${LANG_PORTUGUESEBR} "O ${PRODUCTNAME} ${VERSION} já está instalado. Escolha o que fazer e clique em Próximo."
LangString appRunning ${LANG_PORTUGUESEBR} "O ${PRODUCTNAME} está aberto (talvez escondido perto do relógio). Feche ele e tente de novo."
LangString appRunningOkKill ${LANG_PORTUGUESEBR} "O ${PRODUCTNAME} está aberto (talvez escondido perto do relógio).$\nClique em OK que a gente fecha ele pra atualizar."
LangString chooseMaintenanceOption ${LANG_PORTUGUESEBR} "O que você quer fazer?"
LangString chooseHowToInstall ${LANG_PORTUGUESEBR} "Como você quer instalar o ${PRODUCTNAME}?"
LangString createDesktop ${LANG_PORTUGUESEBR} "Criar atalho na área de trabalho"
LangString dontUninstall ${LANG_PORTUGUESEBR} "Não desinstalar"
LangString dontUninstallDowngrade ${LANG_PORTUGUESEBR} "Não desinstalar (este instalador não instala uma versão mais antiga por cima)"
LangString failedToKillApp ${LANG_PORTUGUESEBR} "Não deu pra fechar o ${PRODUCTNAME}. Feche ele (inclusive pelo ícone perto do relógio, em Sair) e tente de novo."
LangString installingWebview2 ${LANG_PORTUGUESEBR} "Instalando o WebView2..."
LangString newerVersionInstalled ${LANG_PORTUGUESEBR} "Você já tem uma versão mais nova do ${PRODUCTNAME}. Não vale a pena voltar pra uma mais antiga; se quiser mesmo, desinstale a atual antes. Escolha o que fazer e clique em Próximo."
LangString older ${LANG_PORTUGUESEBR} "mais antiga"
LangString olderOrUnknownVersionInstalled ${LANG_PORTUGUESEBR} "Você tem uma versão $R4 do ${PRODUCTNAME}. O melhor é desinstalar ela antes. Escolha o que fazer e clique em Próximo."
LangString silentDowngrades ${LANG_PORTUGUESEBR} "Este instalador não volta pra uma versão mais antiga no modo silencioso. Abra ele normalmente.$\n"
LangString unableToUninstall ${LANG_PORTUGUESEBR} "Não deu pra desinstalar!"
LangString uninstallApp ${LANG_PORTUGUESEBR} "Desinstalar o ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_PORTUGUESEBR} "Desinstalar antes de instalar"
LangString unknown ${LANG_PORTUGUESEBR} "desconhecida"
LangString webview2AbortError ${LANG_PORTUGUESEBR} "Não deu pra instalar o WebView2, e o Espia precisa dele. Abra o instalador de novo."
LangString webview2DownloadError ${LANG_PORTUGUESEBR} "Erro: não deu pra baixar o WebView2 - $0"
LangString webview2DownloadSuccess ${LANG_PORTUGUESEBR} "WebView2 baixado"
LangString webview2Downloading ${LANG_PORTUGUESEBR} "Baixando o WebView2..."
LangString webview2InstallError ${LANG_PORTUGUESEBR} "Erro: a instalação do WebView2 falhou com o código $1"
LangString webview2InstallSuccess ${LANG_PORTUGUESEBR} "WebView2 instalado"
LangString deleteAppData ${LANG_PORTUGUESEBR} "Apagar também as preferências do app"
